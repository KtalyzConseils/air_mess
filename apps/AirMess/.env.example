# URL de l'API Air Mess (Laravel).
# Dev emulateur Android : http://10.0.2.2:8000/api (mappe vers localhost du PC)
# Dev iOS simulateur    : http://127.0.0.1:8000/api
# Dev device physique   : http://<ip-lan-de-votre-pc>:8000/api
# Prod                  : https://api.airmess-logistics.com/api
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api

# Cle Google Maps SDK for Android, injectee par app.config.js.
# Restreindre la cle au package com.airmess.merchant et a Maps SDK for Android.
GOOGLE_MAPS_ANDROID_KEY=AIzaSy...
