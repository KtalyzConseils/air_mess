# Base URL of the deployed AirMess app (marchant-web).
# All landing CTAs (login / register / become a courier) point here.
# Baked into the bundle at build time. Leave unset for local dev (defaults to http://localhost:5173).
VITE_APP_URL=https://app.airmess-logistics.com

# API used by the merchant and driver survey pages.
VITE_API_BASE_URL=https://api.airmess-logistics.com/api

# Local-only opt-in. Never enable this in production because demo submissions
# are intentionally not persisted.
VITE_DRIVER_DEMO_MODE=false
