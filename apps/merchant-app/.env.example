# URL de l'API Air Mess (Laravel).
# Dev émulateur Android : http://10.0.2.2:8000/api
# Dev iOS simulateur    : http://127.0.0.1:8000/api
# Dev device physique   : http://<ip-lan-de-votre-pc>:8000/api
# Prod : https://api.airmess-logistics.com/api
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api

# Base de marchant-web : pages légales + page publique de suivi (/t/<token>).
# Dev : https://dev.app.airmess-logistics.com
# Prod : https://app.airmess-logistics.com  (valeur par défaut si vide)
EXPO_PUBLIC_WEB_BASE_URL=https://dev.app.airmess-logistics.com

# Google Maps SDK for Android (restreindre au package com.airmess.merchantapp)
GOOGLE_MAPS_ANDROID_KEY=AIzaSy...

# Firebase web config (Phone Auth) — mêmes valeurs que marchant-web
# Laisser vide = fallback hardcodé dans src/lib/firebase.ts
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
